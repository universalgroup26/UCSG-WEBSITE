# ============================================
# Cloudflare Configuration
# ============================================

# Cloudflare Web Analytics
# Get your token from: https://dash.cloudflare.com > Web Analytics
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Cloudflare Turnstile (Bot Protection for forms)
# Get your keys from: https://dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================
# Site URL
# ============================================
NEXT_PUBLIC_SITE_URL=https://universalconsultingservices.com