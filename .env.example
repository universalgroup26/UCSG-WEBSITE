# ═══════════════════════════════════════════════════════════════
# UCSG — Environment Variables for Vercel + Cloudflare Deployment
# ═══════════════════════════════════════════════════════════════
#
# REQUIRED FOR VERCEL:
#   Add these in Vercel Dashboard → Settings → Environment Variables
#   Set them for Production, Preview, and Development as needed.
#
# CLOUDFLARE PROXY NOTES:
#   - Vercel's .well-known/acme-challenge/* and .well-known/vercel/*
#     paths MUST pass through Cloudflare without caching or blocking.
#   - Set Cloudflare SSL/TLS to "Full (Strict)" mode.
#   - Do NOT enable Cloudflare's "Always Use HTTPS" page rule that
#     redirects .well-known paths — it will break Vercel cert renewal.
#   - HOST header must be forwarded correctly (Cloudflare does this
#     by default, but custom rules may interfere).
#
# ═══════════════════════════════════════════════════════════════

# ── Database (Prisma Postgres — Cloud PostgreSQL) ──────────────
# DATABASE_URL = Pooled connection (used by app at runtime via @prisma/adapter-pg)
# DIRECT_URL  = Direct connection (used by Prisma CLI for migrations)
# Get these from: https://console.prisma.io → Your project → Settings → Database
DATABASE_URL=
DIRECT_URL=

# ── GoHighLevel (GHL) API ─────────────────────────────────────
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_ID=
# Optional: auto-discovered from NEXT_PUBLIC_UCSG_TRACKING_ID if not set
# Custom field numeric IDs from GHL dashboard (optional)
GHL_FIELD_WHATSAPP=
GHL_FIELD_NATIONALITY=
GHL_FIELD_ENGLISH_LEVEL=
GHL_FIELD_SERVICE=
GHL_FIELD_MESSAGE=
GHL_FIELD_LAST_NAME=
GHL_FIELD_SOURCE=
GHL_FIELD_F1_SITUATION=
GHL_FIELD_DEGREE_LEVEL=
GHL_FIELD_FIELD_OF_STUDY=
GHL_FIELD_PREFERRED_LOCATION=
GHL_FIELD_PREFERRED_FORMAT=
GHL_FIELD_BUDGET_RANGE=
GHL_FIELD_OPT_END_DATE=
GHL_FIELD_TARGET_INTAKE=
GHL_FIELD_CURRENT_UNIVERSITY=

# ── Google Tag Manager ─────────────────────────────────────
# GTM container ID (starts with GTM-XXXXXXX)
# https://tagmanager.google.com → Containers → GTM-M5DGD7Z2
NEXT_PUBLIC_GTM_ID=GTM-M5DGD7Z2

# ── Google Analytics 4 (GA4) ────────────────────────────────
# GA4 Measurement ID (starts with G-)
# Also configured inside GTM; direct gtag.js provides redundancy
NEXT_PUBLIC_GA4_ID=

# ── Microsoft Clarity ───────────────────────────────────────
# Clarity project ID for session replay & heatmaps
# https://clarity.microsoft.com → Settings → Project ID
NEXT_PUBLIC_CLARITY_ID=

# ── Meta Pixel (Direct — fires alongside GTM) ─────────────────
# Meta Pixel ID (from Events Manager → Pixels → your pixel)
# This fires Lead events with currency: 'USD' and value: 50 directly,
# bypassing GTM for reliable ad performance tracking.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only: Conversions API access token (for deduplication)
# Get from: Meta Business Settings → System Users → generate token
# Or: Facebook Graph API Explorer → generate long-lived token
META_PIXEL_ID=
META_ACCESS_TOKEN=

# ── GHL External Tracking (loaded separately from GTM) ──────
NEXT_PUBLIC_UCSG_TRACKING_ID=tk_b6bec4688bdc473b85ae341de9f730fc

# ── Cloudflare Turnstile (Bot Protection) ─────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Cloudflare Web Analytics (Optional) ────────────────────────
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# ── SMTP Email (Contact Form Notifications) ───────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# ── Vercel Deployment (CLI only, not needed in dashboard) ──────
VERCEL_ACCESS_TOKEN=

# ── Cloudflare API (DNS management, not needed at runtime) ─────
CLOUDFLARE_API_TOKEN=

# ── Site Configuration ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.universalconsultingservices.com

# ── OpenRouter (Future AI features, not currently used) ────────
OPENROUTER_API_KEY=
